{
	"name": "@sebastianwessel/isostate-workspace",
	"version": "0.6.0",
	"description": "Scroll-driven animated isometric illustrations with a textual DSL",
	"private": true,
	"type": "module",
	"author": "Sebastian Wessel",
	"license": "MIT",
	"homepage": "https://sebastianwessel.github.io/isostate",
	"bugs": {
		"url": "https://github.com/sebastianwessel/isostate/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/sebastianwessel/isostate.git"
	},
	"files": [
		"packages/core/dist"
	],
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"clean": "rm -rf packages/core/dist packages/cli/dist packages/editor/dist",
		"build": "bun run clean && bun --bun node_modules/rollup/dist/bin/rollup -c rollup.config.ts && bun scripts/build-browser-runtime.ts && bun x tsc -p packages/core/tsconfig.json --emitDeclarationOnly --noCheck && bun x tsc -p packages/cli/tsconfig.json --emitDeclarationOnly --noCheck && bun x tsc -p packages/editor/tsconfig.json --emitDeclarationOnly --noCheck && bun run editor:css && bun run assets:build",
		"editor:css": "bun --bun node_modules/.bin/tailwindcss -i packages/editor/src/style.css -o packages/editor/dist/style.css --minify && cp packages/editor/dist/style.css website/public/editor-style.css",
		"lint": "biome check packages/",
		"format": "biome format --write packages/",
		"test": "bun test",
		"coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov && tsx scripts/check-coverage.ts",
		"typecheck": "tsc --noEmit",
		"size": "tsx scripts/check-size.ts",
		"publint": "publint run packages/core && publint run packages/cli && publint run packages/editor",
		"site:build": "bun scripts/sync-software-assets.ts && bun --bun node_modules/.bin/astro build --root website",
		"site:dev": "bun --bun node_modules/.bin/astro dev --root website --ignore-lock",
		"compile": "tsx scripts/compile.ts",
		"validate": "tsx scripts/validate.ts",
		"isostate": "bun packages/cli/src/bin.ts",
		"examples:basic:serve": "bun run build && python3 -m http.server 4173",
		"examples:basic:bundle": "bun examples/basic/generate-static-bundle.ts",
		"examples:city-growth:serve": "bun run build && python3 -m http.server 4175",
		"examples:city-growth:bundle": "bun examples/city-growth/generate-static-bundle.ts",
		"assets:build": "bun scripts/build-software-assets.ts && bun scripts/sync-software-assets.ts"
	},
	"peerDependencies": {
		"yaml": ">=2.0.0"
	},
	"peerDependenciesMeta": {
		"yaml": {
			"optional": true
		}
	},
	"devDependencies": {
		"@astrojs/sitemap": "^3.7.4",
		"@biomejs/biome": "^2.5.15",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-yaml": "^6.1.3",
		"@codemirror/language": "^6.12.4",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.13",
		"@lezer/highlight": "^1.2.5",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@tailwindcss/cli": "^4.3.3",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"astro": "7.3.5",
		"astro-og-canvas": "^0.13.2",
		"beautiful-mermaid": "1.1.3",
		"canvaskit-wasm": "^0.42.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"happy-dom": "20.14.5",
		"lucide-react": "^1.52.0",
		"publint": "^0.3.25",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"rollup": "^4.64.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"yaml": "^2.9.1",
		"esbuild": "^0.28.2"
	},
	"packageManager": "bun@1.4.2"
}
