{
	"name": "@sebastianwessel/isostate-workspace",
	"version": "0.1.2",
	"description": "Scroll-driven animated isometric illustrations with a textual DSL",
	"private": true,
	"type": "module",
	"author": "Sebastian Wessel",
	"license": "MIT",
	"homepage": "https://sebastianwessel.github.io/isostate",
	"bugs": {
		"url": "https://github.com/sebastianwessel/isostate/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/sebastianwessel/isostate.git"
	},
	"files": ["packages/core/dist"],
	"workspaces": ["packages/*"],
	"scripts": {
		"clean": "rm -rf packages/core/dist packages/cli/dist",
		"build": "bun run clean && tsx node_modules/rollup/dist/bin/rollup -c rollup.config.ts && tsc -p packages/core/tsconfig.json --emitDeclarationOnly --noCheck && tsc -p packages/cli/tsconfig.json --emitDeclarationOnly --noCheck",
		"lint": "biome check packages/",
		"format": "biome format --write packages/",
		"test": "bun test",
		"coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov && tsx scripts/check-coverage.ts",
		"typecheck": "tsc --noEmit",
		"size": "tsx scripts/check-size.ts",
		"publint": "publint run packages/core && publint run packages/cli",
		"site:build": "astro build --root website",
		"site:dev": "astro dev --root website",
		"compile": "tsx scripts/compile.ts",
		"validate": "tsx scripts/validate.ts",
		"isostate": "bun packages/cli/src/bin.ts",
		"examples:basic:bundle": "bun examples/basic/generate-static-bundle.ts"
	},
	"peerDependencies": {
		"yaml": ">=2.0.0"
	},
	"peerDependenciesMeta": {
		"yaml": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.9.1",
		"astro": "6.3.7",
		"publint": "^0.3.21",
		"rollup": "^4.60.4",
		"tsx": "^4.22.3",
		"typescript": "^6.0.3",
		"yaml": "^2.9.0"
	}
}
