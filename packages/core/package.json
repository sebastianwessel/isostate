{
	"name": "@sebastianwessel/isostate",
	"version": "0.1.1",
	"description": "Isometric scene engine — SVG rendering, animation, and YAML DSL for browser-based isometric scenes.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./runtime": {
			"types": "./dist/runtime/index.d.ts",
			"import": "./dist/runtime/index.js"
		},
		"./dsl": {
			"types": "./dist/dsl/index.d.ts",
			"import": "./dist/dsl/index.js"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"sideEffects": false,
	"scripts": {
		"clean": "rm -rf dist",
		"build": "cd ../.. && bun run build",
		"lint": "biome check src/",
		"format": "biome format --write src/",
		"test": "bun test",
		"prepublishOnly": "cd ../.. && bun run build && bun run lint"
	},
	"devDependencies": {
		"typescript": "^6.0.3",
		"@biomejs/biome": "^2.4.15",
		"yaml": "^2.9.0",
		"publint": "^0.3.21",
		"size-limit": "^12.1.0"
	},
	"peerDependencies": {
		"yaml": "^2.9.0"
	},
	"peerDependenciesMeta": {
		"yaml": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"author": "Sebastian Wessel",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/sebastianwessel/isostate.git",
		"directory": "packages/core"
	}
}
