{
	"name": "@sebastianwessel/isostate",
	"version": "0.5.0",
	"description": "Isometric scene engine — SVG rendering, animation, and YAML DSL for browser-based isometric scenes.",
	"keywords": [
		"isostate",
		"isometric",
		"svg",
		"animation",
		"yaml",
		"scrollytelling"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./runtime": {
			"types": "./dist/runtime/index.d.ts",
			"import": "./dist/runtime/index.js"
		},
		"./dsl": {
			"types": "./dist/dsl/index.d.ts",
			"import": "./dist/dsl/index.js"
		},
		"./dsl/browser": {
			"types": "./dist/dsl/browser.d.ts",
			"import": "./dist/dsl/browser.js"
		},
		"./editor-support": {
			"types": "./dist/editor-support/index.d.ts",
			"import": "./dist/editor-support/index.js"
		},
		"./assets/software-architecture/*": "./dist/assets/software-architecture/*"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"sideEffects": false,
	"scripts": {
		"clean": "rm -rf dist",
		"build": "cd ../.. && bun run build",
		"lint": "biome check src/",
		"format": "biome format --write src/",
		"test": "bun test",
		"prepublishOnly": "cd ../.. && bun run build && bun run lint"
	},
	"devDependencies": {
		"typescript": "^7.0.2",
		"@biomejs/biome": "^2.5.15",
		"yaml": "^2.9.1",
		"publint": "^0.3.25",
		"size-limit": "^14.1.0"
	},
	"peerDependencies": {
		"yaml": "^2.9.1"
	},
	"peerDependenciesMeta": {
		"yaml": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"author": "Sebastian Wessel",
	"license": "MIT",
	"homepage": "https://sebastianwessel.github.io/isostate",
	"bugs": {
		"url": "https://github.com/sebastianwessel/isostate/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/sebastianwessel/isostate.git",
		"directory": "packages/core"
	}
}
