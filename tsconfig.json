{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"types": ["bun", "node"],
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"baseUrl": ".",
		"ignoreDeprecations": "6.0",
		"paths": {
			"@/*": ["./*"],
			"@sebastianwessel/isostate": ["packages/core/src/index.ts"],
			"@sebastianwessel/isostate/*": ["packages/core/src/*"]
		},
		"allowImportingTsExtensions": true,
		"outDir": "dist",
		"rootDir": "packages"
	},
	"include": ["packages/**/*.ts", "packages/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"],
	"exclude": ["node_modules", "dist", "tests"]
}
