---
import SiteLayout from '../layouts/SiteLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<SiteLayout
	title="Scene Editor"
	description="Build and edit isostate scenes with the visual editor."
	hideFooter
>
	<link rel="stylesheet" href={`${base}/editor-style.css`} />
	<div class="editor-shell">
		<div id="editor-mount" class="editor-target"></div>
	</div>

	<script>
		import { mountEditor } from '../../../packages/editor/src/index.ts';
		import softwareExample from '../scenes/software-architecture.isostate.yaml?raw';
		import agenticExample from '../scenes/agentic-workflow.isostate.yaml?raw';
		import providerExample from '../scenes/provider-routing.isostate.yaml?raw';

		const target = document.getElementById('editor-mount');
		if (!target) throw new Error('Missing #editor-mount target');

		const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

		const example = new URLSearchParams(window.location.search).get('example');
		const selectedYaml = example === 'software-architecture' ? softwareExample
			: example === 'agentic-workflow' ? agenticExample
			: example === 'provider-routing' ? providerExample : agenticExample;
		const initialYaml = selectedYaml?.replace('assetBaseUrl: ./assets/software-architecture', `assetBaseUrl: ${base}/assets/software-architecture`);

		const editor = mountEditor(target, {
			initialYaml,
			assetManifestUrls: [
				`${base}/assets/software-architecture/manifest.json`,
				`${base}/assets/aws-3d.manifest.json`,
				`${base}/assets/traffic.manifest.json`,
				`${base}/assets/city-growth.manifest.json`
			],
			theme: 'system',
			onChange(event) {
				// eslint-disable-next-line no-console
				console.log('Editor changed:', event.operation.type);
			}
		});

		window.addEventListener('beforeunload', () => editor.destroy(), { once: true });
	</script>
</SiteLayout>

<style>
	.editor-shell {
		height: calc(100dvh - 64px);
		min-height: 560px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.editor-target {
		width: 100%;
		flex: 1;
		min-height: 0;
	}

	@media (max-width: 900px) {
		.editor-shell {
			height: calc(100dvh - 114px);
			min-height: 720px;
		}
	}
</style>
