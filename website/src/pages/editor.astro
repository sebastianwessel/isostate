---
import SiteLayout from '../layouts/SiteLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<SiteLayout
	title="Scene Editor"
	description="Build and edit isostate scenes with the visual editor."
>
	<link rel="stylesheet" href={`${base}/editor-style.css`} />
	<div class="editor-shell">
		<div class="editor-note">
			<strong>Text labels:</strong>
			<span>
				Use <code>cell</code> placement for standalone labels and group names.
				Use <code>caption</code> for one-cell icon labels that share the icon
				position.
			</span>
		</div>
		<div id="editor-mount" class="editor-target"></div>
	</div>

	<script>
		import { mountEditor } from '../../../packages/editor/src/index.ts';

		const target = document.getElementById('editor-mount');
		if (!target) throw new Error('Missing #editor-mount target');

		const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

		const editor = mountEditor(target, {
			assetManifestUrls: [
				`${base}/assets/aws-3d.manifest.json`,
				`${base}/assets/traffic.manifest.json`,
				`${base}/assets/city-growth.manifest.json`
			],
			theme: 'system',
			onChange(event) {
				// eslint-disable-next-line no-console
				console.log('Editor changed:', event.operation.type);
			}
		});

		window.addEventListener('beforeunload', () => editor.destroy(), { once: true });
	</script>
</SiteLayout>

<style>
	.editor-shell {
		height: calc(100dvh - 64px);
		min-height: 560px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.editor-note {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		padding: 0.625rem 1rem;
		border-bottom: 1px solid #dce3ea;
		background: #f8fafc;
		color: #334155;
		font-size: 0.875rem;
	}

	.editor-note code {
		border: 1px solid #cbd5e1;
		border-radius: 4px;
		background: #fff;
		padding: 0.0625rem 0.25rem;
		font-size: 0.8125rem;
	}

	.editor-target {
		width: 100%;
		flex: 1;
		min-height: 0;
	}

	@media (max-width: 900px) {
		.editor-shell {
			height: calc(100dvh - 114px);
			min-height: 720px;
		}
	}
</style>
