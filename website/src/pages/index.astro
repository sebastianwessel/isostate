---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Code } from 'astro:components';
import { overviewChapters } from '../lib/overview-content';
import '../styles/landing-intro.css';
import '../styles/landing-story.css';
import '../styles/landing-sections.css';
import '../styles/landing-responsive.css';
import heroBackgroundUrl from '../../../assets/isostate-story/hero-tilt-shift-city.png?url';
import editorScreenshotUrl from '../../../assets/isostate-story/editor-overview.png?url';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function href(path: string): string {
	return `${base}${path}`;
}


---

<SiteLayout
	title="Isometric scenes from YAML"
	description="isostate turns simple YAML into beautiful scroll-driven isometric visualizations with a real sense of depth — like Mermaid, but isometric. Compile once, embed anywhere."
>
	<div class="landing">

		<!-- ① HERO ──────────────────────────────────────────────── -->
		<section class="hero" id="overview" aria-label="isostate overview">
			<img class="hero-photo" src={heroBackgroundUrl} alt="" aria-hidden="true" />
			<div class="hero-body">
				<p class="tag">Open source · YAML-first · SVG-native</p>
				<h1>Isometric&nbsp;scenes, written like&nbsp;diagrams.</h1>
				<p class="lead">
					Create beautiful, scroll-driven isometric visuals with simple YAML —
					like writing a Mermaid diagram, but with isometric depth.
					Compile once, embed anywhere. No 3D engine required.
				</p>
				<div class="hero-ctas">
					<a class="cta-primary" href="#story">See it in action</a>
					<a class="cta-ghost" href={href('/docs/README.md')}>Read the docs →</a>
				</div>
				<ul class="hero-pills" aria-label="Key facts">
					<li><strong>YAML</strong> scene authoring</li>
					<li><strong>&lt; 20 KB</strong> runtime</li>
					<li><strong>Zero</strong> browser deps</li>
					<li><strong>SVG</strong> no 3D engine</li>
				</ul>
			</div>
		</section>

		<!-- ② HOW IT WORKS ──────────────────────────────────────── -->
		<section class="how-section" aria-label="How isostate works">
			<div class="how-inner">
				<header class="how-header">
					<p class="eyebrow light">Simple by design</p>
					<h2>Three steps from idea to animation.</h2>
					<p class="how-sub">If you can write a diagram, you can create an isostate scene.</p>
				</header>
				<div class="steps">
					<div class="step">
						<span class="step-n">01</span>
						<h3>Write</h3>
						<p>
							Describe your scene in YAML — elements, layers, connections, transitions.
							Small enough to review in a pull request, expressive enough to tell a full visual story.
						</p>
					</div>
					<div class="step-arrow" aria-hidden="true">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</div>
					<div class="step">
						<span class="step-n">02</span>
						<h3>Compile</h3>
						<p>
							Run isostate at build time. It validates your scene, catches broken links and
							missing assets, then produces a tiny optimised browser bundle — nothing heavy ships.
						</p>
					</div>
					<div class="step-arrow" aria-hidden="true">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</div>
					<div class="step">
						<span class="step-n">03</span>
						<h3>Publish</h3>
						<p>
							Drop the output on any static host. Choose scroll-driven storytelling,
							step-through presentation mode, or a static snapshot — one YAML source, your format.
						</p>
					</div>
				</div>

				<div class="yaml-preview">
					<p class="yaml-label">A scene description looks like this</p>
					<pre><code>scenes:
  - id: intro
    elements:
      - id: server
        asset: server-box
        at: [3, 4]
      - id: client
        asset: browser
        at: [7, 4]
    connections:
      - id: request-path
        from: &#123;element: client&#125;
        to:   &#123;element: server&#125;
        style: &#123;pattern: dotted, stroke: "#0f5f4f"&#125;
        ambient:
          - name: flow   # animated data flow</code></pre>
				</div>
			</div>
		</section>

		<!-- ③ LIVE SOFTWARE STORY ───────────────────────────────── -->
		<section class="story-grid" id="story" aria-label="Live software architecture and workflow demo">
			<div class="visual-col">
				<div class="visual-sticky">
					<div class="visual-meta">
						<div class="visual-meta-text">
							<p class="visual-label">One request / seven scenes</p>
							<strong id="scene-title">Request received</strong>
						</div>
						<span class="visual-counter" id="scene-index">01 / 07</span>
					</div>
					<div class="scene-frame">
						<div id="isostate-demo" class="scene-target" aria-label="A request moves through a browser, API, service, worker, AI review, and human approval"></div>
					</div>
					<div class="scene-progress-track" aria-hidden="true"><span id="scene-progress-bar" class="scene-progress-fill"></span></div>
					<div class="story-controls" role="group" aria-label="Choose a story scene">
						{overviewChapters.map((chapter, index) => <button type="button" data-scene-index={index} aria-pressed={index === 0 ? 'true' : 'false'} aria-controls="isostate-demo" title={chapter.title}><span>{String(index + 1).padStart(2, '0')}</span>{chapter.label}</button>)}
					</div>
					<div class="story-toolbar">
						<div role="group" aria-label="Story navigation"><button id="story-prev" type="button" aria-controls="isostate-demo" disabled>← Previous</button><button id="story-next" type="button" aria-controls="isostate-demo">Next →</button></div>
						<button id="story-motion" type="button" aria-pressed="false">Pause effects</button>
					</div>
					<p class="story-hint">Scroll to scrub · Choose a scene to explore</p>
					<div class="story-legend" aria-label="Activity states"><span><i class="processing"></i>Processing</span><span><i class="waiting"></i>Waiting</span><span><i class="complete"></i>Complete</span></div>
					<p id="scene-status" class="sr-only" aria-live="polite"></p>
				</div>
			</div>
			<div class="story-col">
				<div class="story-intro">
					<p class="eyebrow green">Architecture → workflow → process</p>
					<h2>Follow a request.<br />Understand a system.</h2>
					<p class="story-sub">Bring a software story to life with photorealistic assets, flowing connections, and objects that move as you read. Every scene below is a small YAML delta.</p>
				</div>
				{overviewChapters.map((chapter, index) => (
					<article class="chapter" id={`story-${chapter.id}`} data-progress={index / (overviewChapters.length - 1)} data-title={chapter.label} data-index={`${String(index + 1).padStart(2, '0')} / 07`}>
						<p class="chapter-n">Scene {String(index + 1).padStart(2, '0')} / {chapter.label}</p>
						<h3>{chapter.title}</h3>
						<p>{chapter.description}</p>
						<div class="chapter-callout"><span class="callout-label">The visual story</span><strong>{chapter.note}</strong></div>
						<div class="chapter-code"><div class="chapter-code-head"><span>YAML</span><span>{index === 0 ? 'initial scene' : 'scene delta excerpt'}</span></div><Code code={chapter.code} lang="yaml" theme="github-dark" wrap /></div>
					</article>
				))}
			</div>
		</section>

		<!-- ④ EDITOR ───────────────────────────────────────────── -->
		<section class="editor-section" aria-label="isostate editor">
			<div class="editor-copy">
				<p class="eyebrow green">Visual authoring</p>
				<h2>Start visually, keep the YAML.</h2>
				<p>
					Use the editor to place assets, tune scenes, and export the same
					`.isostate.yaml` that the CLI validates and compiles. It is the faster
					way to find anchors, object positions, and scene timing without giving
					up source-controlled text.
				</p>
				<div class="editor-actions">
					<a class="cta-primary" href={href('/editor')}>Open the editor</a>
					<a class="cta-ghost" href={href('/assets')}>Software asset collection →</a>
					<a class="cta-ghost" href={href('/mermaid')}>Mermaid workflow →</a>
					<a class="cta-ghost" href={href('/docs/guides/use-editor-in-astro.md')}>Editor docs →</a>
				</div>
			</div>
			<a class="editor-shot" href={href('/editor')} aria-label="Open the isostate editor">
				<img src={editorScreenshotUrl} alt="isostate editor showing the canvas, YAML editor, and asset browser" loading="lazy" decoding="async" />
			</a>
		</section>

		<!-- ⑤ USE CASES ─────────────────────────────────────────── -->
		<section class="use-cases" aria-label="What you can build">
			<div class="section-inner">
				<header class="section-header">
					<p class="eyebrow green">Use cases</p>
					<h2>Anywhere a static diagram feels flat.</h2>
					<p class="section-sub">
						isostate is a generic tool for isometric visualisation. Here are the places
						where visual sequences make the biggest difference.
					</p>
				</header>
				<div class="use-cases-grid">
					<article class="uc-card" style="--accent: var(--green);">
						<span class="uc-num">01</span>
						<h3>Architecture Docs</h3>
						<p>Reveal system complexity one layer at a time. Readers understand each component before the next arrives.</p>
					</article>
					<article class="uc-card" style="--accent: var(--blue);">
						<span class="uc-num">02</span>
						<h3>Product Tours</h3>
						<p>Walk new users through your product visually. Show features in context instead of describing them in text.</p>
					</article>
					<article class="uc-card" style="--accent: var(--yellow);">
						<span class="uc-num">03</span>
						<h3>Presentations</h3>
						<p>Step through scenes like a slide deck. One YAML file, one compelling story for your audience.</p>
					</article>
					<article class="uc-card" style="--accent: var(--mint);">
						<span class="uc-num">04</span>
						<h3>Technical Blogs</h3>
						<p>Give long articles a visual rhythm. Let the diagram build as the explanation unfolds.</p>
					</article>
					<article class="uc-card" style="--accent: var(--red);">
						<span class="uc-num">05</span>
						<h3>Onboarding Flows</h3>
						<p>Show rather than tell. Guide new team members through infrastructure step by step.</p>
					</article>
					<article class="uc-card" style="--accent: var(--green-dark);">
						<span class="uc-num">06</span>
						<h3>Release Notes</h3>
						<p>Make changelogs worth reading. Show what changed, where it fits, and why it matters — visually.</p>
					</article>
				</div>
			</div>
		</section>

		<!-- ⑥ FEATURES ──────────────────────────────────────────── -->
		<section class="features" aria-label="Key features">
			<div class="section-inner">
				<header class="section-header centered">
					<p class="eyebrow green">Why isostate</p>
					<h2>Designed to stay out of your way.</h2>
				</header>
				<div class="features-grid">
					<article class="feat-card">
						<div class="feat-icon">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><polyline points="14 2 14 8 20 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><line x1="16" y1="13" x2="8" y2="13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><line x1="16" y1="17" x2="8" y2="17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
						</div>
						<h3>YAML you can actually read</h3>
						<p>Write scenes the same way you write configuration. Use it directly or export it from the visual editor — a format anyone on your team can review and extend.</p>
					</article>
					<article class="feat-card">
						<div class="feat-icon">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.8"/><line x1="2" y1="12" x2="22" y2="12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" stroke="currentColor" stroke-width="1.8"/></svg>
						</div>
						<h3>Scroll or step — you decide</h3>
						<p>Use scroll-driven mode for immersive docs and storytelling, or manual step-through for presentations. Same source file, different controllers.</p>
					</article>
					<article class="feat-card">
						<div class="feat-icon">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 2L2 7l10 5 10-5-10-5z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 17l10 5 10-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 12l10 5 10-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</div>
						<h3>Customisable to your brand</h3>
						<p>Theme with CSS variables. Bring your own SVG assets. Choose your colours, stroke widths, and floor styles. isostate doesn't impose a visual style.</p>
					</article>
					<article class="feat-card">
						<div class="feat-icon">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><polyline points="3.27 6.96 12 12.01 20.73 6.96" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><line x1="12" y1="22.08" x2="12" y2="12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
						</div>
						<h3>Static, portable, fast</h3>
						<p>Under 20 KB gzipped. Deploys to GitHub Pages, Netlify, a CDN, or bundled in an npm package. No server component, no lock-in, no hassle.</p>
					</article>
					<article class="feat-card">
						<div class="feat-icon">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><polyline points="7 10 12 15 17 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><line x1="12" y1="15" x2="12" y2="3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
						</div>
						<h3>Interactive, exportable scenes</h3>
						<p>Opt in to pointer interactivity with `element-click`, `element-enter`, and `element-leave` events, or export any scene as a standalone SVG or PNG. A dev-time diagnostics overlay shows grid anchors and connector routes while you tune positions.</p>
					</article>
					<article class="feat-card">
						<div class="feat-icon">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><polyline points="4 17 10 11 4 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><line x1="12" y1="19" x2="20" y2="19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
						</div>
						<h3>Start from a Mermaid diagram</h3>
						<p>Already have a flowchart? Run `isostate mermaid2dsl` to turn a supported Mermaid diagram into a starting `.isostate.yaml` scene — deterministic output, no `mermaid` package shipped to the browser.</p>
					</article>
				</div>
			</div>
		</section>

		<!-- ⑦ GET STARTED ───────────────────────────────────────── -->
		<section class="cta-section" aria-label="Get started with isostate">
			<div class="cta-inner">
				<p class="eyebrow light">Ready to start?</p>
				<h2>Make your docs come&nbsp;alive.</h2>
				<p class="cta-sub">
					You'll have your first scene running in minutes.
					Start with the story-first docs or browse the examples to see what's possible.
				</p>
				<div class="cta-actions">
					<a class="cta-primary" href={href('/docs/README.md')}>Get started</a>
					<a class="cta-ghost-inv" href={href('/docs/examples/runtime-basic.md')}>Browse examples</a>
					<a class="cta-link" href="https://github.com/sebastianwessel/isostate">View on GitHub →</a>
				</div>
			</div>
		</section>

	</div>

	<script>
		import { initializeOverview } from '../lib/overview-story';
		initializeOverview();
	</script>


</SiteLayout>
