---
import { docGroups, docs } from '../docs';

type Props = {
	title: string;
	description?: string;
};

const { title, description = 'isostate documentation' } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const version = import.meta.env.PUBLIC_ISOSTATE_VERSION ?? 'local';

function href(path: string): string {
	return `${base}${path}`;
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<title>{title} | isostate</title>
		<style>
			:root {
				color-scheme: light;
				--ink: #182026;
				--muted: #58656f;
				--line: #d8e0e6;
				--panel: #f6f8fa;
				--accent: #0f766e;
				--accent-ink: #064e46;
				--code: #eef3f6;
				font-family:
					Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
			}

			* {
				box-sizing: border-box;
			}

			body {
				margin: 0;
				background: #ffffff;
				color: var(--ink);
			}

			a {
				color: var(--accent-ink);
				text-decoration-color: rgba(15, 118, 110, 0.35);
				text-underline-offset: 0.18em;
			}

			a:hover {
				text-decoration-color: currentColor;
			}

			.shell {
				display: grid;
				grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
				min-height: 100vh;
			}

			.sidebar {
				border-right: 1px solid var(--line);
				background: var(--panel);
				padding: 24px;
				position: sticky;
				top: 0;
				height: 100vh;
				overflow: auto;
			}

			.brand {
				display: flex;
				flex-direction: column;
				gap: 6px;
				padding-bottom: 20px;
				border-bottom: 1px solid var(--line);
			}

			.brand a {
				color: var(--ink);
				font-size: 1.2rem;
				font-weight: 750;
				text-decoration: none;
			}

			.version {
				color: var(--muted);
				font-size: 0.82rem;
			}

			.nav-group {
				margin-top: 22px;
			}

			.nav-group h2 {
				color: var(--muted);
				font-size: 0.72rem;
				letter-spacing: 0.08em;
				margin: 0 0 8px;
				text-transform: uppercase;
			}

			.nav-group ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.nav-group li + li {
				margin-top: 3px;
			}

			.nav-group a {
				border-radius: 6px;
				color: var(--ink);
				display: block;
				font-size: 0.92rem;
				padding: 6px 8px;
				text-decoration: none;
			}

			.nav-group a[aria-current="page"] {
				background: #dcebe8;
				color: var(--accent-ink);
				font-weight: 650;
			}

			.content {
				min-width: 0;
			}

			.content-inner {
				max-width: 920px;
				padding: 48px 44px 72px;
			}

			:global(article) {
				font-size: 1rem;
				line-height: 1.7;
			}

			:global(article h1) {
				font-size: clamp(2.1rem, 5vw, 4.2rem);
				letter-spacing: 0;
				line-height: 1.02;
				margin: 0 0 18px;
			}

			:global(article h2) {
				border-top: 1px solid var(--line);
				font-size: 1.45rem;
				margin: 38px 0 12px;
				padding-top: 24px;
			}

			:global(article h3) {
				font-size: 1.08rem;
				margin: 26px 0 8px;
			}

			:global(article p),
			:global(article ul),
			:global(article ol),
			:global(article table) {
				color: var(--muted);
			}

			:global(article strong),
			:global(article th) {
				color: var(--ink);
			}

			:global(article code) {
				background: var(--code);
				border-radius: 4px;
				color: #14333f;
				font-size: 0.92em;
				padding: 0.12em 0.32em;
			}

			:global(article pre) {
				background: #172027;
				border-radius: 8px;
				color: #eef6f5;
				overflow: auto;
				padding: 18px;
			}

			:global(article pre code) {
				background: transparent;
				color: inherit;
				padding: 0;
			}

			:global(article table) {
				border-collapse: collapse;
				display: block;
				overflow: auto;
				width: 100%;
			}

			:global(article th),
			:global(article td) {
				border-bottom: 1px solid var(--line);
				padding: 9px 12px;
				text-align: left;
				vertical-align: top;
			}

			@media (max-width: 820px) {
				.shell {
					display: block;
				}

				.sidebar {
					height: auto;
					position: relative;
				}

				.content-inner {
					padding: 34px 22px 56px;
				}
			}
		</style>
	</head>
	<body>
		<div class="shell">
			<aside class="sidebar" aria-label="Documentation navigation">
				<div class="brand">
					<a href={href('/')}>isostate</a>
					<span class="version">version {version}</span>
				</div>

				{
					docGroups.map((group) => (
						<nav class="nav-group" aria-labelledby={`nav-${group}`}>
							<h2 id={`nav-${group}`}>{group}</h2>
							<ul>
								{docs
									.filter((doc) => doc.group === group)
									.map((doc) => {
										const path = `/docs/${doc.slug}`;
										const active = currentPath === `${base}${path}`;
										return (
											<li>
												<a href={href(path)} aria-current={active ? 'page' : undefined}>
													{doc.title}
												</a>
											</li>
										);
									})}
							</ul>
						</nav>
					))
				}
			</aside>
			<main class="content">
				<div class="content-inner">
					<slot />
				</div>
			</main>
		</div>
	</body>
</html>
