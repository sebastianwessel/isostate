---
import { docNav, docs } from '../docs';

type Props = {
	title: string;
	description?: string;
	docsShell?: boolean;
	ogImage?: string;
};

const {
	title,
	description = 'isostate creates compiled isometric SVG scenes for technical storytelling.',
	docsShell = false,
	ogImage = '/og/index.png'
} = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site ?? new URL('https://sebastianwessel.github.io');
const pageTitle = `${title} | isostate`;
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const ogImageUrl = new URL(`${base}${ogImage}`, site).toString();
const docBySlug = new Map(docs.map((doc) => [doc.slug, doc] as const));

function href(path: string): string {
	return `${base}${path}`;
}

function isActive(path: string): boolean {
	return (
		currentPath === `${base}${path}` ||
		currentPath.startsWith(`${base}${path}/`)
	);
}

function navId(value: string): string {
	return `nav-${value.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="isostate" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="author" content="Sebastian Wessel" />
		<title>{pageTitle}</title>
		<link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
		<link rel="apple-touch-icon" sizes="180x180" href={href('/apple-touch-icon.png')} />
		<link rel="manifest" href={href('/site.webmanifest')} />
		<link rel="author" href="https://sebastianwessel.de/projects/isostate/" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<style>
			:root {
				color-scheme: light;
				--ink: #101415;
				--soft-ink: #303835;
				--muted: #68706a;
				--faint: #9a9b8d;
				--paper: #f6f3ea;
				--paper-2: #ebe5d5;
				--panel: #fffdf5;
				--line: #d9d2bf;
				--line-strong: #17201d;
				--green: #0f5f4f;
				--green-dark: #083f35;
				--mint: #78d9ba;
				--yellow: #e7bd45;
				--blue: #537d99;
				--red: #b35b47;
				--code: #ece6d7;
				--shadow: 0 1px 3px rgba(16, 20, 21, 0.1);
				--font-display: "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
				font-family: "Inter", "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
			}

			* {
				box-sizing: border-box;
			}

			html {
				overflow-x: clip;
				scroll-behavior: smooth;
			}

			body {
				margin: 0;
				overflow-x: clip;
				background:
					linear-gradient(90deg, rgba(16, 20, 21, 0.028) 1px, transparent 1px) 0 0 / 64px 64px,
					linear-gradient(rgba(16, 20, 21, 0.022) 1px, transparent 1px) 0 0 / 64px 64px,
					var(--paper);
				color: var(--ink);
			}

			body::before {
				position: fixed;
				inset: 0;
				z-index: -1;
				background:
					radial-gradient(ellipse 80% 60% at 20% 0%, rgba(120, 217, 186, 0.07), transparent),
					radial-gradient(ellipse 60% 40% at 80% 100%, rgba(231, 189, 69, 0.05), transparent),
					linear-gradient(180deg, rgba(255, 253, 245, 0.6), transparent 70%);
				content: "";
			}

			a {
				color: inherit;
				text-decoration-color: rgba(17, 20, 23, 0.32);
				text-underline-offset: 0.18em;
			}

			a:hover {
				text-decoration-color: currentColor;
			}

			.site-topbar {
				position: sticky;
				top: 0;
				z-index: 50;
				display: flex;
				align-items: center;
				gap: 16px;
				min-height: 64px;
				padding: 10px clamp(20px, 4vw, 56px);
				border-bottom: 1px solid rgba(16, 20, 21, 0.1);
				background: rgba(246, 243, 234, 0.94);
				backdrop-filter: blur(20px);
				-webkit-backdrop-filter: blur(20px);
			}

			.brand {
				display: inline-flex;
				align-items: center;
				gap: 10px;
				width: max-content;
				font-size: 1rem;
				font-weight: 700;
				letter-spacing: -0.01em;
				text-decoration: none;
				color: var(--ink);
			}

			/* Isometric cube logo mark */
			.brand-mark {
				position: relative;
				width: 28px;
				height: 28px;
				flex-shrink: 0;
			}

			.brand-mark svg {
				width: 100%;
				height: 100%;
			}

			.nav-links {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: clamp(14px, 2vw, 24px);
				margin: 0 auto;
				padding: 0;
			}

			.nav-links a {
				position: relative;
				display: inline-flex;
				align-items: center;
				min-height: 36px;
				padding: 6px 0;
				color: var(--soft-ink);
				font-size: 0.875rem;
				font-weight: 600;
				text-decoration: none;
				transition: color 140ms ease;
			}

			.nav-links a::after {
				position: absolute;
				right: 0;
				bottom: 2px;
				left: 0;
				height: 2px;
				border-radius: 999px;
				background: currentColor;
				opacity: 0;
				transform: scaleX(0.4);
				transform-origin: center;
				transition:
					opacity 140ms ease,
					transform 140ms ease;
				content: "";
			}

			.nav-links a[aria-current="page"] {
				color: var(--green-dark);
				font-weight: 700;
			}

			.nav-links a[aria-current="page"]::after {
				opacity: 1;
				transform: scaleX(1);
			}

			.nav-links a:hover:not([aria-current="page"]) {
				color: var(--green-dark);
			}

			.nav-links a:hover:not([aria-current="page"])::after {
				opacity: 0.45;
				transform: scaleX(1);
			}

			.topbar-meta {
				justify-self: end;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;
				width: 36px;
				height: 36px;
				padding: 0;
				border-radius: 999px;
				color: var(--soft-ink);
				font-size: 0.85rem;
				font-weight: 600;
				letter-spacing: 0.01em;
				text-decoration: none;
				transition:
					background-color 140ms ease,
					color 140ms ease;
			}

			.topbar-meta:hover {
				background: rgba(16, 20, 21, 0.06);
				color: var(--ink);
			}

			.topbar-meta svg {
				width: 18px;
				height: 18px;
			}

			main {
				min-width: 0;
			}

			.page-shell {
				min-height: calc(100vh - 64px);
			}

			.site-footer {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 18px;
				padding: 28px clamp(20px, 4vw, 56px);
				border-top: 1px solid rgba(16, 20, 21, 0.1);
				color: var(--muted);
				font-size: 0.84rem;
				background: rgba(246, 243, 234, 0.74);
			}

			.site-footer p {
				margin: 0;
			}

			.site-footer strong {
				color: var(--soft-ink);
				font-weight: 650;
			}

			.footer-links {
				display: flex;
				align-items: center;
				justify-content: flex-end;
				flex-wrap: wrap;
				gap: 14px;
			}

			.footer-links a {
				color: var(--soft-ink);
				font-weight: 600;
				text-decoration: none;
			}

			.footer-links a:hover {
				color: var(--green-dark);
				text-decoration: underline;
				text-underline-offset: 0.18em;
			}

			.docs-shell {
				display: grid;
				grid-template-columns: minmax(200px, 260px) minmax(0, 1fr);
				gap: clamp(24px, 4vw, 52px);
				max-width: 1300px;
				margin: 0 auto;
				padding: 40px clamp(20px, 4vw, 56px) 100px;
				align-items: start;
			}

			.docs-sidebar {
				position: sticky;
				top: 80px;
				align-self: start;
				max-height: calc(100vh - 100px);
				overflow-y: auto;
				padding: 6px 0;
			}

			.docs-kicker {
				display: flex;
				align-items: center;
				gap: 8px;
				margin: 0 0 16px;
				padding: 0 12px;
				color: var(--green-dark);
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.07em;
				text-transform: uppercase;
			}

			.docs-kicker::before {
				content: "";
				display: block;
				width: 14px;
				height: 14px;
				background: var(--green);
				clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
				flex-shrink: 0;
			}

			.nav-group + .nav-group {
				margin-top: 24px;
			}

			.nav-group h2 {
				margin: 0 0 4px;
				padding: 0 12px;
				color: var(--faint);
				font-size: 0.68rem;
				font-weight: 700;
				letter-spacing: 0.06em;
				text-transform: uppercase;
			}

			.nav-group ul {
				margin: 0;
				padding: 0;
				list-style: none;
			}

			.nav-group a {
				display: block;
				padding: 6px 12px 6px 14px;
				color: var(--muted);
				font-size: 0.875rem;
				font-weight: 500;
				text-decoration: none;
				border-left: 2px solid transparent;
				border-radius: 0 6px 6px 0;
				transition: color 120ms, background 120ms, border-color 120ms;
			}

			.nav-group a[aria-current="page"] {
				border-color: var(--green);
				background: rgba(15, 95, 79, 0.07);
				color: var(--green-dark);
				font-weight: 600;
			}

			.nav-group a:hover:not([aria-current="page"]) {
				background: rgba(16, 20, 21, 0.04);
				color: var(--ink);
				border-color: rgba(15, 95, 79, 0.2);
			}

			.nav-subgroup {
				margin-top: 8px;
			}

			.nav-subgroup h3 {
				margin: 8px 0 2px;
				padding: 0 12px 0 22px;
				color: var(--faint);
				font-size: 0.68rem;
				font-weight: 700;
				letter-spacing: 0.05em;
				text-transform: uppercase;
			}

			.nav-subgroup a {
				padding-left: 28px;
				font-size: 0.84rem;
			}

			.docs-content {
				min-width: 0;
				max-width: 860px;
				padding: clamp(28px, 4vw, 48px) clamp(24px, 4vw, 52px);
				border: 1px solid rgba(15, 95, 79, 0.1);
				border-radius: 12px;
				background: rgba(255, 255, 255, 0.82);
			}

			:global(.code-frame),
			:global(.mermaid-frame) {
				position: relative;
				margin: 22px 0;
			}

			:global(.code-frame pre),
			:global(.mermaid-frame pre) {
				margin: 0;
			}

			:global(.docs-tool) {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 32px;
				height: 32px;
				border: 1px solid rgba(15, 95, 79, 0.14);
				border-radius: 8px;
				background: rgba(255, 253, 245, 0.92);
				color: var(--green-dark);
				cursor: pointer;
				transition:
					background-color 140ms ease,
					border-color 140ms ease,
					color 140ms ease;
			}

			:global(.docs-tool:hover) {
				border-color: rgba(15, 95, 79, 0.34);
				background: #fffdf5;
				color: var(--ink);
			}

			:global(.docs-tool svg) {
				width: 16px;
				height: 16px;
				pointer-events: none;
			}

			:global(.code-copy) {
				position: absolute;
				top: 10px;
				right: 10px;
				z-index: 2;
			}

			:global(.mermaid-card) {
				border: 1px solid rgba(15, 95, 79, 0.14);
				border-radius: 10px;
				background: #fffdf5;
				overflow: hidden;
			}

			:global(.mermaid-toolbar) {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 12px;
				padding: 10px 12px;
				border-bottom: 1px solid rgba(15, 95, 79, 0.1);
				background: rgba(15, 95, 79, 0.04);
			}

			:global(.mermaid-actions) {
				display: flex;
				align-items: center;
				gap: 6px;
				flex-shrink: 0;
			}

			:global(.mermaid-viewport) {
				position: relative;
				min-height: 260px;
				max-height: 520px;
				overflow: hidden;
				touch-action: none;
				cursor: grab;
				background:
					linear-gradient(90deg, rgba(15, 95, 79, 0.045) 1px, transparent 1px) 0 0 / 28px 28px,
					linear-gradient(rgba(15, 95, 79, 0.04) 1px, transparent 1px) 0 0 / 28px 28px,
					#fffdf5;
			}

			:global(.mermaid-viewport.is-dragging) {
				cursor: grabbing;
			}

			:global(.mermaid-stage) {
				display: flex;
				align-items: center;
				justify-content: center;
				min-width: 100%;
				min-height: 320px;
				padding: 24px;
				transform-origin: 0 0;
				will-change: transform;
			}

			:global(.mermaid-stage svg) {
				max-width: min(100%, 920px);
				height: auto;
			}

			:global(.mermaid-error) {
				padding: 18px 20px;
				color: #8a3428;
				font-family: "SFMono-Regular", Consolas, monospace;
				font-size: 0.84rem;
				white-space: pre-wrap;
			}

			:global(.mermaid-frame:fullscreen) {
				padding: 24px;
				background: var(--paper);
			}

			:global(.mermaid-frame:fullscreen .mermaid-card) {
				height: calc(100vh - 48px);
			}

			:global(.mermaid-frame:fullscreen .mermaid-viewport) {
				height: calc(100vh - 112px);
				max-height: none;
			}

			@media (prefers-reduced-motion: reduce) {
				*,
				*::before,
				*::after {
					animation-duration: 1ms !important;
					scroll-behavior: auto !important;
					transition-duration: 1ms !important;
				}
			}

			:global(article) {
				font-size: 1rem;
				line-height: 1.72;
				color: var(--soft-ink);
			}

			:global(article h1) {
				margin: 0 0 20px;
				font-family: var(--font-display);
				font-size: clamp(2rem, 4.5vw, 3.4rem);
				font-weight: 800;
				letter-spacing: -0.02em;
				line-height: 1.0;
				color: var(--ink);
			}

			:global(article h2) {
				margin: 48px 0 14px;
				padding-top: 24px;
				border-top: 1px solid rgba(15, 95, 79, 0.12);
				font-family: var(--font-display);
				font-size: 1.55rem;
				font-weight: 700;
				letter-spacing: -0.01em;
				color: var(--ink);
			}

			:global(article h3) {
				margin: 28px 0 8px;
				font-size: 1.05rem;
				font-weight: 600;
				color: var(--ink);
			}

			:global(article p),
			:global(article ul),
			:global(article ol) {
				color: var(--soft-ink);
			}

			:global(article table) {
				color: var(--soft-ink);
			}

			:global(article a) {
				color: var(--green-dark);
				text-decoration-color: rgba(15, 95, 79, 0.3);
			}

			:global(article a:hover) {
				text-decoration-color: var(--green-dark);
			}

			:global(article strong),
			:global(article th) {
				color: var(--ink);
				font-weight: 600;
			}

			:global(article code) {
				padding: 0.14em 0.38em;
				border-radius: 4px;
				background: rgba(15, 95, 79, 0.08);
				color: var(--green-dark);
				font-size: 0.875em;
				font-family: "SFMono-Regular", Consolas, monospace;
			}

			:global(article pre) {
				overflow: auto;
				padding: 20px 22px;
				border-radius: 10px;
				border: 1px solid rgba(15, 95, 79, 0.14);
				background: #0f1c18;
				color: #c8f0e0;
			}

			:global(article pre code) {
				padding: 0;
				background: transparent;
				color: inherit;
				font-size: 0.84rem;
			}

			:global(article table) {
				display: block;
				width: 100%;
				overflow: auto;
				border-collapse: collapse;
				border-radius: 8px;
				overflow: hidden;
			}

			:global(article th) {
				background: rgba(15, 95, 79, 0.06);
				font-size: 0.82rem;
				letter-spacing: 0.03em;
				text-transform: uppercase;
			}

			:global(article th),
			:global(article td) {
				padding: 10px 14px;
				border-bottom: 1px solid rgba(15, 95, 79, 0.1);
				text-align: left;
				vertical-align: top;
			}

			:global(article blockquote) {
				margin: 0;
				padding: 14px 20px;
				border-left: 3px solid var(--green);
				background: rgba(15, 95, 79, 0.05);
				border-radius: 0 8px 8px 0;
				color: var(--soft-ink);
			}

			:global(article hr) {
				border: none;
				border-top: 1px solid rgba(15, 95, 79, 0.12);
				margin: 36px 0;
			}

			@media (max-width: 900px) {
				.site-topbar {
					flex-wrap: wrap;
					gap: 10px;
				}

				.nav-links {
					order: 3;
					width: 100%;
					justify-content: flex-start;
					gap: 18px;
					overflow-x: auto;
				}

				.topbar-meta {
					margin-left: auto;
				}

				.docs-shell {
					display: block;
					padding-top: 24px;
				}

				.docs-sidebar {
					position: relative;
					top: auto;
					max-height: none;
					margin-bottom: 22px;
				}

				.site-footer {
					align-items: flex-start;
					flex-direction: column;
				}

				.footer-links {
					justify-content: flex-start;
				}
			}
		</style>
	</head>
	<body>
		<header class="site-topbar">
			<a class="brand" href={href('/')} aria-label="isostate home">
				<span class="brand-mark" aria-hidden="true">
					<svg viewBox="0 0 28 28" xmlns="http://www.w3.org/2000/svg">
						<!-- isometric cube -->
						<polygon points="14,3 25,9.5 25,20.5 14,27 3,20.5 3,9.5" fill="#e7bd45" stroke="#083f35" stroke-width="1.5" stroke-linejoin="round"/>
						<polygon points="14,3 25,9.5 14,16 3,9.5" fill="#78d9ba" stroke="#083f35" stroke-width="1.5" stroke-linejoin="round"/>
						<polygon points="14,16 25,9.5 25,20.5 14,27" fill="#0f5f4f" stroke="#083f35" stroke-width="1.5" stroke-linejoin="round"/>
						<polygon points="14,16 3,9.5 3,20.5 14,27" fill="#083f35" stroke="#083f35" stroke-width="1.5" stroke-linejoin="round"/>
					</svg>
				</span>
				<span>isostate</span>
			</a>
			<nav class="nav-links" aria-label="Primary navigation">
				<a href={href('/')} aria-current={currentPath === base || currentPath === `${base}/` ? 'page' : undefined}>Overview</a>
				<a href={href('/#story')}>Demo</a>
				<a href={href('/docs/README.md')} aria-current={isActive('/docs') ? 'page' : undefined}>Docs</a>
				<a href={href('/editor')} aria-current={isActive('/editor') ? 'page' : undefined}>Editor</a>
			</nav>
			<a class="topbar-meta" href="https://github.com/sebastianwessel/isostate" aria-label="Open GitHub repository" title="GitHub">
				<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
					<path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.1c-3.3.7-4-1.4-4-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 .1 1.7 1.5 3.4 1.1.1-.8.4-1.3.7-1.6-2.8-.3-5.8-1.4-5.8-6.1 0-1.3.5-2.4 1.2-3.3-.1-.3-.5-1.6.1-3.3 0 0 1-.3 3.4 1.2a11.8 11.8 0 0 1 6.2 0c2.4-1.6 3.4-1.2 3.4-1.2.6 1.7.2 3 .1 3.3.8.9 1.2 2 1.2 3.3 0 4.7-2.9 5.8-5.7 6.1.5.4.9 1.1.9 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z"/>
				</svg>
			</a>
		</header>

		<main class={docsShell ? 'docs-shell' : 'page-shell'}>
			{
				docsShell ? (
					<>
						<aside class="docs-sidebar" aria-label="Documentation navigation">
							<p class="docs-kicker">Documentation</p>
							{docNav.map((section) => (
								<nav class="nav-group" aria-labelledby={navId(section.title)}>
									<h2 id={navId(section.title)}>{section.title}</h2>
									{section.items.map((item) => {
										if (item.type === 'doc') {
											const doc = docBySlug.get(item.slug);
											if (!doc) return null;
											const path = `/docs/${doc.slug}`;
											const active = currentPath === `${base}${path}`;
											return (
												<ul>
													<li>
														<a href={href(path)} aria-current={active ? 'page' : undefined}>
															{doc.title}
														</a>
													</li>
												</ul>
											);
										}
										return (
											<div class="nav-subgroup">
												<h3>{item.title}</h3>
												<ul>
													{item.items.map((slug) => {
														const doc = docBySlug.get(slug);
														if (!doc) return null;
														const path = `/docs/${doc.slug}`;
														const active = currentPath === `${base}${path}`;
														return (
															<li>
																<a href={href(path)} aria-current={active ? 'page' : undefined}>
																	{doc.title}
																</a>
															</li>
														);
													})}
												</ul>
											</div>
										);
									})}
								</nav>
							))}
						</aside>
						<div class="docs-content">
							<slot />
						</div>
					</>
				) : (
					<slot />
				)
			}
		</main>
		<footer class="site-footer">
			<p>
				A project by <strong>Sebastian Wessel</strong>.
			</p>
			<nav class="footer-links" aria-label="Project links">
				<a href="https://sebastianwessel.de/projects/isostate/">Project page</a>
				<a href="https://sebastianwessel.de/projects/">More projects</a>
				<a href="https://github.com/sebastianwessel/isostate">GitHub</a>
			</nav>
		</footer>
	<script>
		import { renderMermaidSVGAsync } from 'beautiful-mermaid';

		const copyIcon = '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="9" y="9" width="10" height="10" rx="2" stroke="currentColor" stroke-width="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
		const checkIcon = '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m20 6-11 11-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
		const zoomInIcon = '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M11 8v6M8 11h6M16.5 16.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
		const zoomOutIcon = '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M8 11h6M16.5 16.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
		const fitIcon = '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
		const fullscreenIcon = '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';

		function button(label, icon, className = '') {
			const control = document.createElement('button');
			control.type = 'button';
			control.className = `docs-tool ${className}`.trim();
			control.innerHTML = icon;
			control.setAttribute('aria-label', label);
			control.title = label;
			return control;
		}

		async function copyText(text, control) {
			await navigator.clipboard.writeText(text);
			const previous = control.innerHTML;
			control.innerHTML = checkIcon;
			window.setTimeout(() => {
				control.innerHTML = previous;
			}, 900);
		}

		function enhanceCodeBlocks() {
			for (const pre of document.querySelectorAll('article pre')) {
				if (pre.closest('.code-frame') || pre.closest('.mermaid-frame')) continue;
				const code = pre.querySelector('code');
				if (!code) continue;
				if (
					code.className.includes('language-mermaid') ||
					pre.dataset.language === 'mermaid'
				) continue;
				const frame = document.createElement('div');
				frame.className = 'code-frame';
				pre.replaceWith(frame);
				frame.append(pre);
				const copy = button('Copy code', copyIcon, 'code-copy');
				copy.addEventListener('click', () => copyText(code.textContent ?? '', copy));
				frame.append(copy);
			}
		}

		function setMermaidTransform(stage, state) {
			stage.style.transform = `translate(${state.x}px, ${state.y}px) scale(${state.scale})`;
		}

		function enhanceMermaidPanZoom(frame, viewport, stage) {
			const state = { x: 0, y: 0, scale: 1 };
			const apply = () => setMermaidTransform(stage, state);
			frame.querySelector('[data-action="zoom-in"]')?.addEventListener('click', () => {
				state.scale = Math.min(3, state.scale + 0.15);
				apply();
			});
			frame.querySelector('[data-action="zoom-out"]')?.addEventListener('click', () => {
				state.scale = Math.max(0.4, state.scale - 0.15);
				apply();
			});
			frame.querySelector('[data-action="fit"]')?.addEventListener('click', () => {
				state.x = 0;
				state.y = 0;
				state.scale = 1;
				apply();
			});
			frame.querySelector('[data-action="fullscreen"]')?.addEventListener('click', () => {
				if (document.fullscreenElement) document.exitFullscreen();
				else frame.requestFullscreen?.();
			});

			let pointerId = null;
			let startX = 0;
			let startY = 0;
			let originX = 0;
			let originY = 0;
			viewport.addEventListener('pointerdown', (event) => {
				pointerId = event.pointerId;
				startX = event.clientX;
				startY = event.clientY;
				originX = state.x;
				originY = state.y;
				viewport.setPointerCapture(event.pointerId);
				viewport.classList.add('is-dragging');
			});
			viewport.addEventListener('pointermove', (event) => {
				if (pointerId !== event.pointerId) return;
				state.x = originX + event.clientX - startX;
				state.y = originY + event.clientY - startY;
				apply();
			});
			viewport.addEventListener('pointerup', (event) => {
				if (pointerId !== event.pointerId) return;
				pointerId = null;
				viewport.classList.remove('is-dragging');
			});
			viewport.addEventListener(
				'wheel',
				(event) => {
					event.preventDefault();
					const delta = event.deltaY > 0 ? -0.1 : 0.1;
					state.scale = Math.min(3, Math.max(0.4, state.scale + delta));
					apply();
				},
				{ passive: false }
			);
			apply();
		}

		async function enhanceMermaidBlocks() {
			const mermaidBlocks = Array.from(
				new Set([
					...document.querySelectorAll('article pre code.language-mermaid'),
					...document.querySelectorAll('article pre[data-language="mermaid"] code')
				])
			);
			if (mermaidBlocks.length === 0) return;

			for (const code of mermaidBlocks) {
				const source = code.textContent ?? '';
				const pre = code.closest('pre');
				if (!pre) continue;
				const frame = document.createElement('div');
				frame.className = 'mermaid-frame';
				const card = document.createElement('div');
				card.className = 'mermaid-card';
				const toolbar = document.createElement('div');
				toolbar.className = 'mermaid-toolbar';
				const actions = document.createElement('div');
				actions.className = 'mermaid-actions';
				const copy = button('Copy Mermaid source', copyIcon);
				copy.addEventListener('click', () => copyText(source, copy));
				for (const [label, icon, action] of [
					['Zoom in', zoomInIcon, 'zoom-in'],
					['Zoom out', zoomOutIcon, 'zoom-out'],
					['Reset view', fitIcon, 'fit'],
					['Fullscreen', fullscreenIcon, 'fullscreen']
				]) {
					const control = button(label, icon);
					control.dataset.action = action;
					actions.append(control);
				}
				actions.prepend(copy);
				toolbar.append(actions);
				const viewport = document.createElement('div');
				viewport.className = 'mermaid-viewport';
				const stage = document.createElement('div');
				stage.className = 'mermaid-stage';
				viewport.append(stage);
				card.append(toolbar, viewport);
				pre.replaceWith(frame);
				frame.append(card);

				try {
					stage.innerHTML = await renderMermaidSVGAsync(source, {
						bg: '#fffdf5',
						fg: '#101415'
					});
				} catch (error) {
					const message = error instanceof Error ? error.message : String(error);
					const errorElement = document.createElement('div');
					errorElement.className = 'mermaid-error';
					errorElement.textContent = message;
					stage.replaceChildren(errorElement);
				}
				enhanceMermaidPanZoom(frame, viewport, stage);
			}
		}

		enhanceCodeBlocks();
		enhanceMermaidBlocks();
	</script>
	</body>
</html>
